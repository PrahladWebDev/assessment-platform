# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/assessment_platform

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Your self-hosted compiler service (see the API you already built)
COMPILER_BASE_URL=https://compiler.prahladsingh.in/api/v2
COMPILER_API_KEY=your_x_compiler_key_here
COMPILER_TIMEOUT_MS=10000

# Execution limits
MAX_CONCURRENT_COMPILER_CALLS=5
RUN_RATE_LIMIT_PER_MINUTE=15
SUBMIT_RATE_LIMIT_PER_MINUTE=5

# CORS — comma-separated, no spaces needed around commas. Must match wherever the
# candidate app and admin app are actually running.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Redis (report caching + Socket.IO adapter-friendly pub/sub). Leave unset to
# run without a cache — the app degrades gracefully to "always compute fresh".
REDIS_URL=redis://127.0.0.1:6379
REPORT_CACHE_TTL_SECONDS=15
